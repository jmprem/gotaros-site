---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, formatDate, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt, keyPoints, draft } = post.data;
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={`${title} — TAROS`} description={description} current="blog">
  <article class="article">
    <header class="article-header">
      <div class="container article-grid">
        <div>
        <p class="article-header__back"><a href="/blog/">← All posts</a></p>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="Topics">
            {tags.map((tag) => <li class="tag-list__item">{tag}</li>)}
          </ul>
        )}
        <h1 class="article-header__title">{title}</h1>
        <p class="article-header__lead">{description}</p>
        <p class="article-meta">
          <span class="article-meta__author">TAROS by jamberi</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <><span aria-hidden="true">·</span><span>Updated {formatDate(updatedDate)}</span></>}
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body ?? '')} min read</span>
          {draft && <span class="draft-badge">Draft — not published</span>}
        </p>
        {heroImage && (
          <div class="article-hero">
            <img src={heroImage} alt={heroAlt ?? ''} width="600" height="340" />
          </div>
        )}
        </div>
      </div>
    </header>

    <div class="container article-grid article-layout">
      <div class="article-body">
        {keyPoints && keyPoints.length > 0 && (
          <aside class="key-points" aria-label="In short">
            <p class="key-points__title">In short</p>
            <ul>
              {keyPoints.map((point) => <li>{point}</li>)}
            </ul>
          </aside>
        )}
        <div class="prose">
          <Content />
        </div>

        <aside class="author-box">
          <p class="author-box__name">TAROS by jamberi</p>
          <p class="author-box__text">TAROS, the Trusted Autonomous Runtime Oversight System, monitors autonomous systems and AI/SI agents while they run, applies signed policies, and records every decision with its reason.</p>
          <p class="author-box__links"><a href="/platform.html">How the platform works</a> · <a href="/blog/">More posts</a> · <a href="/rss.xml">RSS</a></p>
        </aside>
      </div>

      {toc.length > 1 && (
        <nav class="article-toc" aria-label="On this page">
          <p class="article-toc__title">On this page</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
    </div>
  </article>

  <section class="section" id="cta">
    <div class="container">
      <div class="cta-block">
        <h2 class="cta-block__title">Explore TAROS</h2>
        <p class="cta-block__text">See how TAROS monitors autonomous systems and AI/SI agents while they run, or talk to us about becoming a design partner.</p>
        <a href="/contact.html" class="cta-block__link">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
